<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="gameLayer" prefHeight="645.0" prefWidth="1020.0"
            style="-fx-background-color: #121212;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.client.controller.dashboard.GameCornerController">
   <children>

      <VBox alignment="CENTER" spacing="10.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
         <children>
            <Label text="GACHA ROULETTE" textFill="#D4AF37">
               <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            <Label text="Bắt xu may mắn để tích luỹ lượt quay!" textFill="#A0A0A0">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="25.0"
            style="-fx-background-color: #181818; -fx-background-radius: 30; -fx-padding: 12 35;
                   -fx-border-color: #D4AF37; -fx-border-width: 1px; -fx-border-radius: 30;
                   -fx-effect: dropshadow(gaussian, rgba(212,175,55,0.2), 15, 0, 0, 0);"
			AnchorPane.bottomAnchor="40.0"
			  AnchorPane.leftAnchor="0.0"
			  AnchorPane.rightAnchor="0.0">
         <children>

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Circle fill="#D4AF37" radius="12.0" />
                  <Label fx:id="bidCounter" text="Bids: 0" textFill="#D4AF37">
                     <font><Font name="System Bold" size="18.0" /></font>
                  </Label>
               </children>
            </HBox>

            <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#handlePlayGame"
                    style="-fx-background-color: #242424; -fx-background-radius: 20;
                           -fx-text-fill: #E0E0E0; -fx-cursor: hand; -fx-padding: 7 15;"
                    text="⏱️ Chơi Game (30s)" />

            <Button fx:id="btnFeed" mnemonicParsing="false" onAction="#handleFeedPet"
                    style="-fx-background-color: #FF4757; -fx-background-radius: 20;
                           -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 7 15; -fx-font-weight: bold;"
                    text="❤️ Cho Ăn (5 Bids)" />

            <Button fx:id="btnGacha" mnemonicParsing="false" onAction="#handleRollGacha"
                    style="-fx-background-color: linear-gradient(to right, #D4AF37, #FFD700);
                           -fx-background-radius: 20; -fx-text-fill: #121212;
                           -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-padding: 7 20; -fx-font-size: 14px;"
                    text="🎁 MỞ RƯƠNG BÁU (10 Bids)" />

         </children>
      </HBox>
   </children>
</AnchorPane>